# The corpus. About 15GB, and several files exceed GitHub's 100MB hard limit -
# caselaws_v2.index alone is 3.9GB. Since 6 Nov 2026 it is a folder inside the
# checkout (moved from the earlier Agentified NM folder), not a junction.
# See README.md. Never `git add -f` any of it.
legal_database/
.nm-artefacts/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv*/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage
.coverage.*

# Node
node_modules/
dist/
build/
.vite/

# Secrets and local configuration. NM_MATTER_KEY and NM_MATTER_SALT live here
# and must never be committed — matter state is sealed with them.
.env
.env.*
!.env.example
*.local
.claude/settings.local.json

# Generated at run time
.nm/
# Local run output and evidence, never tracked.
/outputs/

# Stores written at runtime
*.db
*.db-shm
*.db-wal
*.sqlite3
.code-review-graph/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
.nm/dev-matter-key
