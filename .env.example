# Nyaymalaw — model configuration.
#
# Copy to .env and fill in. .env is gitignored; this file is not.
#
# THE RULE (PRD §7.4.2): steps declare a TIER, never a model. Changing provider
# is a change to this file and nothing else. A model identifier appearing
# anywhere in nm/core/ fails the build.

# ---------------------------------------------------------------- provider ---
# Must be on the permitted allow-list (PRD §7.4.5). An unlisted provider fails
# at startup rather than being used — every call sends privileged client
# material to a third party, so this is a confidentiality decision, not only a
# technical one.
NM_MODEL_PROVIDER=openai

# --------------------------------------------------------------- the tiers ---
# Use the explicit release IDs registered in model_config.py. The approved GPT-6
# model pages publish these names without dated snapshots. Record returned IDs.

# Extraction and research readers.
NM_MODEL_ROUTINE=gpt-6-luna

# Grounded answer writing, approved by the owner on 10 October 2026.
NM_MODEL_HARD=gpt-6.1-sol

# Independent review uses a separate call and original evidence. Sharing Sol
# with the writer does not provide model diversity; preserve that explicit policy.
NM_MODEL_JUDGE=gpt-6.1-sol
NM_ALLOW_SAME_MODEL_REVIEW=true

# embed — READ AND VERIFIED, NOT CHOSEN. The indices were built with this model;
# querying them with another returns plausible, confidently wrong neighbours
# rather than an error. Changing it is a full re-index of the corpus, planned as
# an ingest project. See PRD §7.4.2 carve-out.
NM_EMBED_MODEL=text-embedding-3-large

# --------------------------------------------------------------- transport ---
NM_MODEL_API_KEY=sk-REPLACE-ME
# NM_MODEL_BASE_URL=                 # only for a proxy or a self-hosted endpoint

# Point ONE tier at a different provider without moving the rest, e.g. to keep
# the judge on a different family from the model under test:
# NM_MODEL_PROVIDER_JUDGE=anthropic
# NM_MODEL_API_KEY_JUDGE=

# ------------------------------------------------------------------- local ---
NM_CORPUS_DIR=legal_database/vector_store
NM_MATTER_STORE=.nm/matters
# Matter state is encrypted at rest and the key lives OUTSIDE the repository.
# An unconfigured key is a hard failure, never a silent no-op that returns
# ciphertext as plaintext (PRD §7.5).
NM_MATTER_KEY=
