#!/bin/sh
# After `git merge` and `git pull` -- fast-forward or merge commit alike.
#
# Neither runs pre-commit: a merge commit runs pre-merge-commit, and a
# fast-forward runs no commit hook at all. This is how the semantic index
# fell 600 nodes behind on 12 September 2026 with the pre-commit refresh in
# place and working. See refresh-graph for the measurement.
#
# `$1` is 1 for a squash merge. The tree changed either way, so it is not
# consulted. Never blocks -- a post-* hook cannot, and this one would not.
"$(git rev-parse --show-toplevel)/assurance/hooks/refresh-graph"
