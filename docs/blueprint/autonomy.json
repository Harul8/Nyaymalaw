    "metrics": ["professional_usefulness", "unsupported_material_claims", "adverse_omissions", "source_readback", "advocate_review_time", "unnecessary_questions", "task_completion", "boundary_violations", "latency_percentiles", "total_cost_per_quality_approved_task"],
