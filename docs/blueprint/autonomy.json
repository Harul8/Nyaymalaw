    "repeat_policy": "predeclare_repeats_retain_all_runs_report_variability",
    "population_policy": "nonempty_independently_enumerated_strata_no_missing_result_success",
    "decision_rule": "retain_delegation_only_for_measured_benefit_without_safety_waiver"
  },
  "obligations": [
    {"id": "AUTO-01", "title": "Adaptive lead and mandate", "item": "BK-91", "criterion": "BK-91-AC1", "packet": "P46", "requirement": "Choose and revise evidence-driven next actions within the task mandate; no fixed legal scenario router and no self-expanded authority."},
    {"id": "AUTO-02", "title": "Grounding and invalidation", "item": "BK-91", "criterion": "BK-91-AC2", "packet": "P46", "requirement": "Keep claims attributed and version-linked, reject unsupported material conclusions and invalidate affected work when sources, instructions or permissions change."},
    {"id": "AUTO-03", "title": "Purposeful interaction", "item": "BK-91", "criterion": "BK-91-AC3", "packet": "P24", "requirement": "Retrieve available answers before questioning, respect interruption, explain changed plans and stop unavailable or unchanged-answer loops."},
    {"id": "AUTO-04", "title": "Professional behavioural comparison", "item": "BK-91", "criterion": "BK-91-AC4", "packet": "P35", "requirement": "Compare three operating modes on fixed representative sources with independent counsel review, preregistered repeats and complete outcome accounting."},
    {"id": "AUTO-05", "title": "Bounded delegated task contract", "item": "BK-92", "criterion": "BK-92-AC1", "packet": "P47", "requirement": "Persist parent-child mandates, typed tasks/results, reduced capabilities, atomic shared budgets and finite concurrency/depth; reuse durable jobs."},
    {"id": "AUTO-06", "title": "Isolated execution and reconciliation", "item": "BK-92", "criterion": "BK-92-AC2", "packet": "P47", "requirement": "Reauthorise before protected operations; refuse forged, stale, revoked or cancelled results; expose failure and merge candidates through one canonical acceptance owner."},
    {"id": "AUTO-07", "title": "Draft and artifact lineage", "item": "BK-92", "criterion": "BK-92-AC3", "packet": "P29", "requirement": "Preserve material claim/source/annexure identity through specialist handoff and final Word/PDF rendering from one accepted semantic version; never infer send/file authority."},
    {"id": "AUTO-08", "title": "Delegation economics and capacity", "item": "BK-92", "criterion": "BK-92-AC4", "packet": "P37", "requirement": "Measure shared budget races, cancellation and retries plus total cost, latency and review effort; retain specialists only when the measured task-stratum benefit justifies complexity."}
  ]
}
