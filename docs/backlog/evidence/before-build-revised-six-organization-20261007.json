  "activities": {
    "1": [
      "1. Understand the request and objective",
      "Understand the immediate request, broader objective, urgency, practical constraints and authorised scope in the full conversation context."
    ],
    "2": [
      "2. Build and examine the account, evidence and issues",
      "Capture significant material, attribution, uncertainty, corrections and omissions. Examine the record and identify relevant issues without inventing disputes."
    ],
    "3": [
      "3. Find, interpret and qualify law",
      "Retrieve substantive and procedural law. Check applicability, currency and authority; distinguish party submissions from what the court adopted, rejected or decided."
    ],
    "4": [
      "4. Apply law and test competing positions",
      "Connect checked law to the available evidence. Test adverse facts, alternative explanations and opposing arguments; identify decisive missing support."
    ],
    "5": [
      "5. Recommend a practical course",
      "Compare supported options against the objective, risks and constraints. Recommend proportionate next steps and prioritise consequential evidence needs."
    ],
    "6": [
      "6. Deliver authorised work and maintain progress through closure",
      "Produce and check the requested work. Track actual outcomes, pending tasks and obligations through handover, closure and reopening."
    ]
  },
